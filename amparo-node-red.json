  {
    "id": "bf1b09ca7b6b9b6e",
    "type": "function",
    "z": "1deed3728b5a63f1",
    "name": "traduz UltraLight",
    "func": "// O aparelho envia no formato UltraLight do FIWARE (o mesmo que aparece no MyMQTT):\n//   leitura: t|28.5|h|55.0|ic|29.1|icp|30.2|tx|0.30|gh|0.00|e|NORMAL\n//   evento:  ev|sos|ee|SOS|eic|39.2|ha|0|atr|0\n// Aqui viramos isso em objeto e mandamos para a saída certa:\n//   saída 1 = leitura, saída 2 = evento\nconst texto = String(msg.payload).trim();\nconst partes = texto.split('|');\nif (partes.length < 2 || partes.length % 2 !== 0) {\n    node.warn('Mensagem fora do formato UltraLight: ' + texto);\n    return null;\n}\nconst a = {};\nfor (let i = 0; i < partes.length; i += 2) a[partes[i]] = partes[i + 1];\n\nif (a.ev !== undefined) {\n    const evento = {\n        evento: a.ev,\n        estado: a.ee,\n        ic: Number(a.eic),\n        haSegundos: Number(a.ha) || 0,\n        atrasado: a.atr === '1'\n    };\n    return [null, { payload: evento }];\n}\n\nconst leitura = {\n    temp: Number(a.t),\n    umid: Number(a.h),\n    ic: Number(a.ic),\n    icProjetado: Number(a.icp),\n    taxa: Number(a.tx),\n    grausHora: Number(a.gh),\n    estado: a.e\n};\nreturn [{ payload: leitura }, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 940,
    "y": 300,
    "wires": [["50fef43136174230"], ["6e6440fb466d6e34"]]
  },
  {
    "id": "4de86076f303e7c2",
    "type": "function",
    "z": "1deed3728b5a63f1",
    "name": "confirmação do aparelho",
    "func": "// O aparelho confirma o comando: \"amparo001@ajuda|ok\"\nconst texto = String(msg.payload).trim();\nif (!texto.includes('@ajuda|')) return null;\nconst ultima = (flow.get('historico') || []).slice(-1)[0];\nmsg.payload = { evento: 'ajuda', estado: ultima ? ultima.estado : '', ic: ultima ? ultima.ic : 0, haSegundos: 0, atrasado: false };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 950,
    "y": 360,
    "wires": [["6e6440fb466d6e34"]]
  },
  {
    "id": "50fef43136174230",
    "type": "function",
    "z": "1deed3728b5a63f1",
    "name": "guarda leitura",
    "func": "// Recebe a leitura do aparelho (já em JSON), guarda no histórico e envia ao painel\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\nd.recebidoEm = Date.now();\n\nconst historico = flow.get('historico') || [];\nhistorico.push(d);\nwhile (historico.length > 300) historico.shift();   // guarda as últimas 300 leituras\nflow.set('historico', historico);\n\nnode.status({ fill: 'green', shape: 'dot', text: d.estado + ' · ' + d.ic + ' °C' });\nmsg.payload = JSON.stringify({ tipo: 'leitura', dados: d });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1160,
    "y": 280,
    "wires": [["361a0ed2d6a00878", "6e0f93107e347377"]]
  },
  {
    "id": "6e6440fb466d6e34",
    "type": "function",
    "z": "1deed3728b5a63f1",
    "name": "guarda evento",
    "func": "// Recebe um evento do aparelho (mudança de estado, SOS, \"estou bem\"...)\n// Eventos atrasados (enviados quando a internet voltou) trazem há quantos segundos aconteceram\nconst e = msg.payload;\nif (typeof e !== 'object' || e === null) return null;\ne.quando = Date.now() - (Number(e.haSegundos) || 0) * 1000;\n\nconst eventos = flow.get('eventos') || [];\neventos.push(e);\nwhile (eventos.length > 50) eventos.shift();\nflow.set('eventos', eventos);\n\nnode.status({ fill: e.evento === 'sos' ? 'red' : 'blue', shape: 'ring', text: e.evento + (e.atrasado ? ' (atrasado)' : '') });\nmsg.payload = JSON.stringify({ tipo: 'evento', dados: e });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1160,
    "y": 340,
    "wires": [["361a0ed2d6a00878", "6e0f93107e347377"]]
  },
