  {
    "id": "89a3efd982d4b3fa",
    "type": "inject",
    "z": "1deed3728b5a63f1",
    "name": "Simular leitura",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 680,
    "y": 720,
    "wires": [["b26a21f0687ac16b"]]
  },
  {
    "id": "b26a21f0687ac16b",
    "type": "function",
    "z": "1deed3728b5a63f1",
    "name": "leitura falsa",
    "func": "// SÓ PARA TESTE: gera leituras falsas para testar o painel sem o Wokwi.\n// A cada clique, a temperatura sobe 1,5 °C e volta a 26 °C depois de 37 °C.\nlet t = flow.get('simTemp') || 26;\nt = t >= 37 ? 26 : t + 1.5;\nflow.set('simTemp', t);\n\nconst ic = t < 27 ? t + 0.4 : t + (t - 27) * 0.8 + 0.4;   // aproximação só para o teste\nconst estado = ic >= 39 ? 'PERIGO' : ic >= 32 ? 'ATENCAO' : 'NORMAL';\nconst gh = (flow.get('simGh') || 0) + Math.max(0, ic - 32) / 6;\nflow.set('simGh', gh);\n\n// Mesmo formato UltraLight que o ESP32 publica\nmsg.payload = 't|' + t.toFixed(1) + '|h|50.0|ic|' + ic.toFixed(1) + '|icp|' + (ic + 1).toFixed(1) +\n              '|tx|1.20|gh|' + gh.toFixed(2) + '|e|' + estado;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 880,
    "y": 720,
    "wires": [["bf1b09ca7b6b9b6e"]]
